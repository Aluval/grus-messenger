
from datetime import datetime, timezone

from bson import ObjectId
from flask import Blueprint, current_app, jsonify, request

from routes.auth import token_required
from routes.connections import are_connected, is_blocked

messages_bp = Blueprint(
    "messages",
    __name__,
    url_prefix="/api/messages"
)

MAX_ENCRYPTED_PAYLOAD_LENGTH = 20000


def get_collection():
    return current_app.extensions["mongo_db"]["messages"]


def get_conversation(conversation_id):
    if not ObjectId.is_valid(conversation_id):
        return None

    return current_app.extensions["mongo_db"]["conversations"].find_one({
        "_id": ObjectId(conversation_id)
    })


def check_conversation_access(current_user, conversation):
    user_id = current_user["_id"]

    if user_id not in conversation["participants"]:
        return False

    other_user_id = next(
        (
            participant
            for participant in conversation["participants"]
            if participant != user_id
        ),
        None
    )

    if other_user_id is None:
        return False

    if is_blocked(user_id, other_user_id):
        return False

    if not are_connected(user_id, other_user_id):
        return False

    return True


# Send an encrypted message
@messages_bp.post("/<conversation_id>")
@token_required
def send_message(current_user, conversation_id):
    conversation = get_conversation(conversation_id)

    if not conversation:
        return jsonify({
            "error": "Conversation not found"
        }), 404

    if not check_conversation_access(current_user, conversation):
        return jsonify({
            "error": "Messaging is not available for this conversation"
        }), 403

    data = request.get_json(silent=True) or {}

    encrypted_payload = data.get("encrypted_payload")

    if not isinstance(encrypted_payload, str):
        return jsonify({
            "error": "Encrypted message payload is required"
        }), 400

    encrypted_payload = encrypted_payload.strip()

    if not encrypted_payload:
        return jsonify({
            "error": "Encrypted message payload cannot be empty"
        }), 400

    if len(encrypted_payload) > MAX_ENCRYPTED_PAYLOAD_LENGTH:
        return jsonify({
            "error": "Encrypted message payload is too large"
        }), 400

    # New messages must use an encrypted payload.
    # Plaintext content is deliberately not accepted.
    now = datetime.now(timezone.utc)

    message = {
        "conversation_id": ObjectId(conversation_id),
        "sender_id": current_user["_id"],
        "encrypted_payload": encrypted_payload,
        "encryption_status": "encrypted_payload_received",
        "created_at": now,
    }

    result = get_collection().insert_one(message)

    current_app.extensions["mongo_db"]["conversations"].update_one(
        {"_id": ObjectId(conversation_id)},
        {"$set": {"last_message_at": now}}
    )

    return jsonify({
        "message": "Encrypted payload received",
        "data": {
            "id": str(result.inserted_id),
            "conversation_id": conversation_id,
            "sender_id": str(current_user["_id"]),
            "encrypted_payload": encrypted_payload,
            "encryption_status": "encrypted_payload_received",
            "created_at": now.isoformat(),
        }
    }), 201


# Retrieve messages
@messages_bp.get("/<conversation_id>")
@token_required
def get_messages(current_user, conversation_id):
    conversation = get_conversation(conversation_id)

    if not conversation:
        return jsonify({
            "error": "Conversation not found"
        }), 404

    if not check_conversation_access(current_user, conversation):
        return jsonify({
            "error": "Messaging is not available for this conversation"
        }), 403

    results = get_collection().find(
        {"conversation_id": ObjectId(conversation_id)}
    ).sort("created_at", 1).limit(100)

    messages = []

    for message in results:
        message_data = {
            "id": str(message["_id"]),
            "sender_id": str(message["sender_id"]),
            "created_at": message["created_at"].isoformat(),
        }

        if "encrypted_payload" in message:
            message_data.update({
                "encrypted_payload": message["encrypted_payload"],
                "encryption_status": message.get(
                    "encryption_status",
                    "encrypted_payload_received"
                )
            })

        else:
            # Preserve and identify existing plaintext messages.
            message_data.update({
                "content": message.get("content", ""),
                "encryption_status": "legacy_plaintext"
            })

        messages.append(message_data)

    return jsonify({
        "messages": messages
    }), 200
